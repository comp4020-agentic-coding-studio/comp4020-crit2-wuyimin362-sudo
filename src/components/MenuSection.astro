---
import type { MenuCategory } from "../data/menu";

interface Props {
  category: MenuCategory;
}

const { category } = Astro.props;
const slug = category.title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const headingId = `menu-${slug}`;
---

<section class="menu-section" aria-labelledby={headingId}>
  <h3 id={headingId}>{category.title}</h3>
  {category.note ? <p class="menu-section__note">{category.note}</p> : null}
  <ul class="menu-section__list">
    {
      category.items.map((item) => (
        <li class="menu-item">
          <div class="menu-item__row">
            <span class="menu-item__name">{item.name}</span>
            <span class="menu-item__price">{item.price}</span>
          </div>
          {item.description ? <p class="menu-item__desc">{item.description}</p> : null}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .menu-section {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-section:last-child {
    border-bottom: none;
  }

  .menu-section h3 {
    margin-bottom: var(--space-2);
  }

  .menu-section__note {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    font-style: italic;
    margin-bottom: var(--space-5);
    max-width: var(--text-max-width);
  }

  .menu-section__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .menu-item__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .menu-item__name {
    font-weight: 500;
  }

  .menu-item__price {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink-soft);
  }

  .menu-item__desc {
    margin-top: var(--space-1);
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    max-width: var(--text-max-width);
  }
</style>
