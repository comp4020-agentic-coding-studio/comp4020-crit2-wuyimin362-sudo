---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactInfo from "../components/ContactInfo.astro";
import { href } from "../lib/url";
import { site } from "../data/site";
import { dinnerMenu } from "../data/menu";
import sakeService from "../assets/photos/sake-service.jpg";
import sashimi from "../assets/photos/sashimi.jpg";

const miyabi = dinnerMenu[0].items[0];

const preview = [
  dinnerMenu[0].items.find((i) => i.name === "Miyabi Course")!,
  dinnerMenu[2].items.find((i) => i.name === "Sashimi")!,
  dinnerMenu[4].items.find((i) => i.name === "Dragon Rolls")!,
  dinnerMenu[0].items.find((i) => i.name === "Sho Jin Degustation")!,
];
---

<BaseLayout
  title="IORI — Kaiseki & Sushi Bar Dining, Canberra"
  description="IORI is a Japanese restaurant on East Row in Canberra City, serving kaiseki-style degustation courses and sushi bar dining since well before most of its neighbours."
>
  <section class="hero">
    <div class="hero__media">
      <Image src={sakeService} alt="Two bottles of sake chilling in a lacquered ice bucket at IORI's bar counter" widths={[480, 800, 1200]} sizes="100vw" />
    </div>
    <div class="hero__text container">
      <p class="hero__kanji" aria-hidden="true">{site.kanji}</p>
      <h1>{site.name}</h1>
      <p class="hero__tagline">{site.tagline}</p>
    </div>
  </section>

  <section class="section recognition">
    <div class="container recognition__row">
      <h2 class="section-label">Recognition</h2>
      {
        site.awards.map((award) => (
          <p class="recognition__item">
            <strong>{award.name}</strong> — {award.detail}
          </p>
        ))
      }
    </div>
  </section>

  <section class="section intro">
    <div class="container intro__grid">
      <SectionHeading label="Who we are" heading="One kitchen, two ways to eat it" />
      <div class="intro__copy">
        <p>
          IORI seats guests at a sushi bar, at tables, and in a private function
          room — the same kitchen running sushi-bar service and kaiseki-style
          degustation courses side by side, on East Row in the middle of
          Canberra City.
        </p>
        <p>
          It's the kind of place that's been quietly winning "Favourite Japanese
          Restaurant" for six years running without needing to say so loudly.
        </p>
      </div>
    </div>
  </section>

  <section class="section signature">
    <div class="container signature__grid">
      <div class="signature__media">
        <Image src={sashimi} alt="A sashimi and sushi arrangement with ikura and avocado, plated at IORI" widths={[480, 800, 1100]} sizes="(min-width: 56rem) 50vw, 100vw" />
      </div>
      <div class="signature__text">
        <SectionHeading label="Signature course" heading={miyabi.name} level={3} />
        <p class="signature__price">{miyabi.price}</p>
        <p>{miyabi.description}</p>
      </div>
    </div>
  </section>

  <section class="section menu-preview">
    <div class="container">
      <SectionHeading label="On the menu" heading="From sushi-bar staples to kaiseki courses" />
      <ul class="menu-preview__list">
        {
          preview.map((item) => (
            <li>
              <span class="menu-preview__name">{item.name}</span>
              <span class="menu-preview__price">{item.price}</span>
            </li>
          ))
        }
      </ul>
      <a class="menu-preview__link" href={href("menu/")}>View the full menu →</a>
    </div>
  </section>

  <section class="section atmosphere">
    <div class="container atmosphere__grid">
      <SectionHeading label="Atmosphere" heading="Sushi bar, tables, or a room of your own" />
      <div class="atmosphere__copy">
        <p>
          A weeknight plate at the sushi bar and a full kaiseki degustation
          for a celebration come out of the same kitchen, cooked with the
          same care either way.
        </p>
      </div>
    </div>
  </section>

  <section class="section visit">
    <div class="container">
      <SectionHeading label="Visit" heading="Find us on East Row" />
      <ContactInfo variant="compact" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    color: var(--color-bg);
  }

  .hero__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 34rem;
    overflow: hidden;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero__text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block-end: var(--space-8);
    background: linear-gradient(to top, rgb(0 0 0 / 55%), transparent 60%);
  }

  .hero__kanji {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-bg);
    opacity: 0.85;
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    color: var(--color-bg);
  }

  .hero__tagline {
    font-size: var(--text-body-lg);
    max-width: 40ch;
    margin-top: var(--space-3);
  }

  .recognition {
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .recognition__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    align-items: baseline;
  }

  .recognition__item {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }

  .recognition__item strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-8);
  }

  .intro__copy p {
    margin-bottom: var(--space-4);
  }

  .signature {
    background: var(--color-surface);
  }

  .signature__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .signature__media img {
    border-radius: var(--radius-sm);
  }

  .signature__price {
    color: var(--color-ink-soft);
    margin-block: var(--space-2) var(--space-4);
  }

  .menu-preview__list {
    list-style: none;
    padding: 0;
    max-width: 34rem;
    margin-block: var(--space-6);
  }

  .menu-preview__list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-preview__price {
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .menu-preview__link {
    font-weight: 500;
  }

  .atmosphere__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
  }

  .atmosphere__copy {
    display: flex;
    align-items: center;
  }

  .visit {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 56.25rem) {
    .intro__grid,
    .signature__grid,
    .atmosphere__grid {
      grid-template-columns: 1fr;
    }

    .hero__media {
      aspect-ratio: 3 / 4;
      max-height: 30rem;
    }
  }
</style>
